# =============================================================================
# Medigent One Backend Environment Configuration
# =============================================================================
# Single-model architecture: both primary and secondary agents default to
# Gemma 4 31B Instruct via the Gemini API.
# These values serve as defaults when the frontend does not provide them.

# --- Primary Model Configuration ---
# Model platform. Common values:
#   gemini                   - Google Gemini API (also serves Gemma models)
#   openai                   - OpenAI API
#   openai-compatible-model  - vLLM / llama.cpp / LMStudio / any OpenAI-compat server
MODEL_PLATFORM=gemini

# Model identifier
#   For Gemini:                gemma-4-31b-it, gemini-2.0-flash, etc.
#   For OpenAI:                gpt-4o, gpt-4o-mini, etc.
#   For openai-compatible:     gemma-4-31b-it (served by local llama.cpp)
MODEL_TYPE=gemma-4-31b-it

# API key for the model provider
GEMINI_API_KEY=your_google_ai_studio_key

# (Optional) Custom API endpoint URL
# Required for openai-compatible-model (e.g. http://localhost:8080/v1).
# Leave empty for cloud providers (Gemini, OpenAI) which use their defaults.
API_URL=

# --- Secondary Agent Configuration ---
# In Medigent One the secondary agent also runs on Gemma 4 31B.
# Leave SECONDARY_API_URL empty to skip the secondary-endpoint health check
# (the Gemini API has no equivalent /health endpoint to probe).
SECONDARY_API_URL=
SECONDARY_MODEL_PLATFORM=gemini
SECONDARY_MODEL_TYPE=gemma-4-31b-it

# (Optional) Bearer token for self-hosted secondary endpoints
# SECONDARY_API_KEY=

# Maximum context window in tokens. Gemma 4 31B Instruct supports up to 128k.
SECONDARY_CONTEXT_SIZE=128000

# --- Encryption Key ---
# Used to encrypt/decrypt sensitive data like API keys from frontend
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# --- Search Configuration (Optional) ---
# GOOGLE_API_KEY=
# SEARCH_ENGINE_ID=
